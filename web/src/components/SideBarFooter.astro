---
import { url } from "../config";
import { INFO_CARDS } from "../data/infoCards";
import { DEMO_SITE } from "../data/demoSite";
---
<div class="hidden lg:block shrink-0 px-4 pb-2 bg-ac-cream-dark">
  <button onclick="toggleTheme()" class="flex items-center gap-2 px-3 py-1.5 w-full rounded-ac-md transition-colors hover:bg-ac-sand text-sm" aria-label="切换主题" title="切换主题">
    <img src={url("icon-sun.svg")} alt="" class="w-5 h-5 rounded-ac-sm show-light" />
    <img src={url("icon-moon.svg")} alt="" class="w-5 h-5 rounded-ac-sm show-dark" />
    <span class="show-light">深色模式</span><span class="show-dark">浅色模式</span>
  </button>
  {DEMO_SITE.isDemo && <p class="px-3 pt-2 text-xs opacity-60">{DEMO_SITE.demoBadge}</p>}
</div>
<div class="hidden lg:flex shrink-0 flex-col items-start px-4 pb-5 pt-1 bg-ac-cream-dark gap-1">
  {INFO_CARDS.map((card) => (
    <button type="button" data-info-card={card.id} aria-haspopup="dialog" aria-controls="island-info-dialog" class="flex items-center gap-2 px-3 py-1.5 rounded-ac-md transition-colors hover:bg-ac-sand text-sm text-left w-full" aria-label={"打开" + card.label + "信息卡片"}>
      <img src={url(card.icon)} alt="" class="w-5 h-5 rounded-ac-sm" />
      <span>{card.label}</span>
    </button>
  ))}
</div>
<div class="flex lg:hidden shrink-0 items-center justify-around gap-1 bg-ac-cream-dark px-3 pt-2 pb-4">
  <button onclick="toggleTheme()" class="w-10 h-10 rounded-ac-md" aria-label="切换主题">◐</button>
  {INFO_CARDS.map((card) => (
    <button type="button" data-info-card={card.id} aria-haspopup="dialog" aria-controls="island-info-dialog" class="w-10 h-10 rounded-ac-md flex items-center justify-center" aria-label={"打开" + card.label + "信息卡片"}>
      <img src={url(card.icon)} alt="" class="w-5 h-5 rounded-ac-sm" />
    </button>
  ))}
</div>

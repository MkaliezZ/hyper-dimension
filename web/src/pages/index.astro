---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION } from "../config";
import { HOTSPOTS } from "../data/island";
import { DEMO_SITE } from "../data/demoSite";
---

<BaseLayout sideBarActiveItemID="home" title="林屿的云上手作岛 · 欢迎登岛" fullBleed>
  <section class="island-page" id="island-page" aria-label="可交互小岛">
    <div class="island-sky" aria-hidden="true">
      <img src={"/" + DEMO_SITE.assets.background} alt="" width="1536" height="1024" draggable="false" decoding="async" />
    </div>
    <div class="island-viewport" id="island-viewport">
      <div class="island-art" id="island-art">
        <div class="island-float" id="island-float">
          <img
            class="island-foreground"
            src={"/" + DEMO_SITE.assets.island}
            alt="漂浮在天空中的六栋房屋、溪流与瀑布"
            width="1536"
            height="1024"
            draggable="false"
            decoding="async"
            fetchpriority="high"
          />
          {HOTSPOTS.map((hotspot) => (
            <button
              type="button"
              class="island-hotspot"
              data-hotspot-id={hotspot.id}
              aria-label={hotspot.name + "：" + hotspot.signText}
              style={"clip-path: polygon(" + hotspot.polygon + ")"}
            >
              <span class="sr-only">{hotspot.name}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <div id="island-follow" class="island-follow" aria-hidden="true" hidden>
      <span class="follow-card">
        <strong id="follow-title"></strong>
        <small><span id="follow-action"></span> ↗</small>
      </span>
    </div>

    <div class="hero-float">
      {DEMO_SITE.isDemo && <span class="demo-badge">{DEMO_SITE.demoBadge}</span>}
      <h1>{DEMO_SITE.heroTitle}</h1>
      <p>{SITE_DESCRIPTION}</p>
      <small>{DEMO_SITE.heroHint}</small>
    </div>

    <div class="island-controls" aria-label="小岛视图控制">
      <button type="button" id="zoom-out" aria-label="缩小">−</button>
      <button type="button" id="zoom-in" aria-label="放大">＋</button>
      <button type="button" id="zoom-reset">回正</button>
    </div>

    <div id="island-dialog" class="dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="dialog-title" hidden>
      <div class="dialog-card">
        <button id="dialog-close" type="button" aria-label="关闭弹窗">✕</button>
        <div class="dialog-icon" aria-hidden="true">🏠</div>
        <h2 id="dialog-title"></h2>
        <p id="dialog-description"></p>
        <p id="dialog-note"></p>
      </div>
    </div>
  </section>

  <script>
    import { HOTSPOTS } from "../data/island";

    function initIsland2D() {
      const root = document.getElementById("island-page");
      const viewport = document.getElementById("island-viewport");
      const art = document.getElementById("island-art");
      const dialog = document.getElementById("island-dialog");
      if (!root || !viewport || !art || !dialog || root.dataset.bound) return;
      root.dataset.bound = "1";

      const byId = new Map(HOTSPOTS.map((hotspot) => [hotspot.id, hotspot]));
      const follower = document.getElementById("island-follow");
      const followTitle = document.getElementById("follow-title");
      const followAction = document.getElementById("follow-action");
      const hideFollower = () => { if (follower) follower.hidden = true; };
      const moveFollower = (clientX: number, clientY: number) => {
        if (!follower) return;
        const bounds = root.getBoundingClientRect();
        const x = clientX - bounds.left;
        const y = clientY - bounds.top;
        follower.style.transform = "translate3d(" + x + "px," + y + "px,0)";
        follower.classList.toggle("flip-x", x > bounds.width - 200);
        follower.classList.toggle("flip-y", y > bounds.height - 100);
      };
      const title = document.getElementById("dialog-title");
      const description = document.getElementById("dialog-description");
      const note = document.getElementById("dialog-note");
      const closeButton = document.getElementById("dialog-close");
      let zoom = 1;
      let offsetX = 0;
      let offsetY = 0;
      let didDrag = false;
      let lastClickAt = 0;
      let clickTimer: number | undefined;
      let pinchDistance = 0;
      const pointers = new Map<number, { x: number; y: number }>();
      const listeners = new AbortController();
      document.addEventListener("astro:before-swap", () => {
        listeners.abort();
        if (clickTimer) window.clearTimeout(clickTimer);
      }, { once: true });

      const clamp = (value: number) => Math.max(1, Math.min(3, value));
      const render = () => {
        art.style.transform = "translate(" + offsetX + "px," + offsetY + "px) scale(" + zoom + ")";
      };
      const reset = () => {
        zoom = 1;
        offsetX = 0;
        offsetY = 0;
        render();
      };
      const setZoom = (next: number) => {
        zoom = clamp(next);
        if (zoom === 1) {
          offsetX = 0;
          offsetY = 0;
        }
        render();
      };
      const distance = () => {
        const points = Array.from(pointers.values());
        return Math.hypot(points[0].x - points[1].x, points[0].y - points[1].y);
      };
      const closeDialog = () => {
        dialog.hidden = true;
      };

      if (new URLSearchParams(location.search).has("debug")) root.classList.add("debug");

      viewport.addEventListener("wheel", (event) => {
        event.preventDefault();
        setZoom(zoom * Math.exp(-event.deltaY * 0.001));
      }, { passive: false });

      viewport.addEventListener("pointerdown", (event) => {
        didDrag = false;
        pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
        if (pointers.size === 2) pinchDistance = distance();
      });
      window.addEventListener("pointermove", (event) => {
        const previous = pointers.get(event.pointerId);
        if (!previous) return;
        pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
        const dx = event.clientX - previous.x;
        const dy = event.clientY - previous.y;
        if (Math.abs(dx) + Math.abs(dy) > 2) didDrag = true;
        if (pointers.size === 2 && pinchDistance > 0) {
          const nextDistance = distance();
          if (Math.abs(nextDistance - pinchDistance) > 2) didDrag = true;
          setZoom(zoom * nextDistance / pinchDistance);
          pinchDistance = nextDistance;
        } else if (pointers.size === 1 && zoom > 1) {
          offsetX += dx;
          offsetY += dy;
          render();
        }
      }, { signal: listeners.signal });
      const release = (event: PointerEvent) => {
        pointers.delete(event.pointerId);
        if (pointers.size < 2) pinchDistance = 0;
      };
      window.addEventListener("pointerup", release, { signal: listeners.signal });
      window.addEventListener("pointercancel", release, { signal: listeners.signal });

      root.querySelectorAll<HTMLButtonElement>(".island-hotspot").forEach((button) => {
        const hotspot = byId.get(button.dataset.hotspotId || "");
        if (!hotspot) return;
        const showFollower = (clientX: number, clientY: number) => {
          if (!follower || !followTitle || !followAction) return;
          followTitle.textContent = hotspot.name;
          followAction.textContent = hotspot.signText;
          follower.hidden = false;
          moveFollower(clientX, clientY);
        };
        button.addEventListener("pointerenter", (event) => {
          if (event.pointerType !== "touch") showFollower(event.clientX, event.clientY);
        });
        button.addEventListener("pointermove", (event) => {
          if (event.pointerType !== "touch" && !didDrag) showFollower(event.clientX, event.clientY);
        });
        button.addEventListener("pointerleave", hideFollower);
        button.addEventListener("focus", () => {
          if (!button.matches(":focus-visible")) return;
          const bounds = button.getBoundingClientRect();
          showFollower(bounds.left + bounds.width / 2, bounds.top + bounds.height / 2);
        });
        button.addEventListener("blur", hideFollower);
        button.addEventListener("click", (event) => {
          if (didDrag) {
            event.preventDefault();
            return;
          }
          const now = performance.now();
          if (now - lastClickAt < 500) {
            if (clickTimer) window.clearTimeout(clickTimer);
            clickTimer = undefined;
            lastClickAt = 0;
            reset();
            return;
          }
          lastClickAt = now;
          clickTimer = window.setTimeout(() => {
            clickTimer = undefined;
            if (hotspot.action.type === "link") {
              const base = import.meta.env.BASE_URL || "/";
              const route = hotspot.action.route.replace(/^\//, "");
              location.assign(new URL(route, location.origin + base).toString());
            } else if (hotspot.modal) {
              if (title) title.textContent = hotspot.modal.title;
              if (description) description.textContent = hotspot.modal.description;
              if (note) note.textContent = hotspot.modal.note;
              dialog.hidden = false;
              closeButton?.focus();
            }
          }, 500);
        });
      });

      viewport.addEventListener("dblclick", (event) => {
        event.preventDefault();
        if (clickTimer) window.clearTimeout(clickTimer);
        clickTimer = undefined;
        reset();
      });
      document.getElementById("zoom-in")?.addEventListener("click", () => setZoom(zoom * 1.25));
      document.getElementById("zoom-out")?.addEventListener("click", () => setZoom(zoom / 1.25));
      document.getElementById("zoom-reset")?.addEventListener("click", reset);
      closeButton?.addEventListener("click", closeDialog);
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) closeDialog();
      });
      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeDialog();
      }, { signal: listeners.signal });
    }

    document.addEventListener("astro:page-load", initIsland2D);
    initIsland2D();
  </script>

  <style>
    .island-page { position: absolute; inset: 0; overflow: hidden; isolation: isolate; background: #cfeaff; }
    .island-sky { position: absolute; inset: 0; overflow: hidden; }
    .island-sky img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; animation: sky-drift 34s ease-in-out infinite alternate; transform-origin: center; }
    .island-viewport { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; touch-action: none; }
    .island-art { position: relative; width: min(100%, 1200px); aspect-ratio: 3 / 2; flex: none; transform-origin: center; user-select: none; will-change: transform; }
    .island-float { position: relative; width: 100%; height: 100%; animation: island-bob 7.2s ease-in-out infinite; will-change: transform; }
    .island-foreground { display: block; width: 100%; height: 100%; object-fit: contain; pointer-events: none; filter: drop-shadow(0 24px 26px rgba(43,85,104,.20)); }
    .island-hotspot { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; background: transparent; cursor: pointer; -webkit-tap-highlight-color: transparent; }
    .island-hotspot:focus-visible { outline: 2px solid #e7fff1; outline-offset: -3px; }
    .debug .island-hotspot { background: rgba(235,67,70,.25); }
    .island-follow[hidden] { display: none; }
    .island-follow { position: absolute; left: 0; top: 0; z-index: 19; width: 0; height: 0; pointer-events: none; }
    .follow-card { position: absolute; left: 20px; top: 18px; min-width: 150px; padding: .55rem .8rem; border: 1px solid rgba(255,255,255,.55); border-radius: 12px; color: #fffef8; background: rgba(30,59,64,.88); box-shadow: 0 12px 30px rgba(28,56,66,.28); backdrop-filter: blur(12px); white-space: nowrap; text-align: left; }
    .island-follow.flip-x .follow-card { left: auto; right: 20px; }
    .island-follow.flip-y .follow-card { top: auto; bottom: 18px; }
    .follow-card strong, .follow-card small { display: block; }
    .follow-card strong { font-size: .82rem; letter-spacing: .02em; }
    .follow-card small { margin-top: .15rem; color: #dbefdc; font-size: .68rem; }
    .hero-float { position: absolute; left: 50%; bottom: 1rem; z-index: 20; transform: translateX(-50%); width: max-content; max-width: min(92vw,720px); text-align: center; padding: .6rem 1.2rem; border: 1px solid rgba(255,255,255,.74); border-radius: 20px; background: rgba(255,253,245,.82); color: #365041; box-shadow: 0 10px 30px rgba(44,81,91,.17); backdrop-filter: blur(14px); pointer-events: none; }
    .hero-float h1 { margin: 0; font-size: 1.4rem; font-weight: 750; }
    .hero-float p { margin: .1rem 0; font-size: .85rem; }
    .hero-float small { font-size: .7rem; opacity: .75; }
    .island-controls { position: absolute; right: 1.1rem; bottom: 1.1rem; z-index: 30; display: flex; gap: .4rem; }
    .island-controls button { border: 1px solid rgba(255,255,255,.68); border-radius: 12px; min-width: 38px; min-height: 38px; padding: 0 .7rem; background: rgba(255,253,245,.84); color: #22665d; font-weight: 700; box-shadow: 0 8px 22px rgba(44,81,91,.16); backdrop-filter: blur(12px); }
    .island-controls button:hover { background: #fffef6; transform: translateY(-2px); }
    .dialog-backdrop[hidden] { display: none; }
    .dialog-backdrop { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: #263b3980; padding: 1rem; }
    .dialog-card { position: relative; width: min(100%,460px); padding: 1.4rem; border-radius: 22px; background: #fffdf7; color: #405342; box-shadow: 0 20px 55px #0004; }
    #dialog-close { position: absolute; top: .8rem; right: .8rem; border: 0; border-radius: 50%; width: 32px; height: 32px; background: #e8e9df; }
    .dialog-icon { font-size: 2rem; }
    .dialog-card h2 { margin: .4rem 0; font-size: 1.3rem; font-weight: 700; }
    .dialog-card p { margin-top: .7rem; line-height: 1.6; }
    #dialog-note { font-size: .78rem; opacity: .7; }
    @keyframes island-bob { 0%,100% { transform: translateY(6px); } 50% { transform: translateY(-9px); } }
    @keyframes sky-drift { 0% { transform: scale(1.045) translateX(-.3%); } 100% { transform: scale(1.085) translateX(.3%); } }
    @media (prefers-reduced-motion: reduce) { .island-float, .island-sky img { animation: none; } }
    @media (hover: none) { .island-follow { display: none; } }
    @media (max-width: 680px) {
      .hero-float { bottom: 4.2rem; padding: .45rem .75rem; }
      .hero-float h1 { font-size: 1.1rem; }
      .hero-float p { display: none; }
      .island-controls { right: .8rem; bottom: .8rem; }

    }
  </style>
</BaseLayout>


<style>
  .demo-badge { display: inline-block; margin-bottom: .4rem; padding: .25rem .65rem; border-radius: 999px; color: #2c695f; background: rgba(255,253,246,.9); border: 1px solid rgba(57,124,112,.4); font-size: .68rem; font-weight: 800; letter-spacing: .05em; }
</style>

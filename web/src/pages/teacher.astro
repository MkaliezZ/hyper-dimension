---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="教师工作台 · Hyper Dimension DEMO"
  sideBarActiveItemID="teacher"
>
  <div id="teacher-dashboard" class="teacher-page">
    <div class="teacher-heading">
      <div>
        <p class="teacher-eyebrow">HYPER DIMENSION · TEACHER DEMO</p>
        <h1>教师工作台</h1>
        <p>从班级进入学生档案，核对教材进度与可审计的归档记录。</p>
      </div>
      <span class="teacher-badge">仅限模拟资料</span>
    </div>

    <section class="teacher-card" aria-labelledby="connection-title">
      <h2 id="connection-title">连接本地教师 API</h2>
      <p class="teacher-hint">
        令牌只保存在当前页面内存中，刷新后需重新输入。请勿使用真实学生资料或生产凭据。
      </p>
      <div id="teacher-connect" class="teacher-connect">
        <label
          >班级 ID<input
            id="teacher-class"
            name="class"
            value="class-demo"
            autocomplete="off"
            required
          /></label
        >
        <label
          >本地演示令牌<input
            id="teacher-token"
            name="token"
            type="password"
            autocomplete="off"
            required
          /></label
        >
        <button class="btn-ac" type="button">读取班级</button>
      </div>
      <p
        id="teacher-status"
        class="teacher-status"
        role="status"
        aria-live="polite"
      >
        等待连接。
      </p>
    </section>

    <div id="teacher-workspace" class="teacher-workspace" hidden>
      <section class="teacher-card" aria-labelledby="roster-title">
        <div class="teacher-card-heading">
          <div>
            <p class="teacher-eyebrow">CLASS</p><h2 id="roster-title">
              班级学生
            </h2>
          </div>
          <span id="roster-count" class="teacher-count"></span>
        </div>
        <ul id="teacher-roster" class="teacher-roster"></ul>
        <p id="roster-more" class="teacher-hint" hidden>
          当前只显示前 100 位学生。
        </p>
      </section>

      <section class="teacher-card" aria-labelledby="pending-title">
        <div class="teacher-card-heading">
          <div>
            <p class="teacher-eyebrow">ASSESSMENT QUEUE</p>
            <h2 id="pending-title">待批改答卷</h2>
          </div>
          <button id="pending-refresh" type="button">刷新</button>
        </div>
        <p class="teacher-hint">
          教师 Agent 通过 MCP
          读取写作作答与量规并提交评分草稿；这里仅显示待处理引用。
        </p>
        <p
          id="pending-status"
          class="teacher-hint"
          role="status"
          aria-live="polite"
        >
        </p>
        <ul id="pending-attempts" class="teacher-roster"></ul>
      </section>

      <section class="teacher-card" aria-labelledby="alignment-title">
        <div class="teacher-card-heading">
          <div>
            <p class="teacher-eyebrow">LEARNING ALIGNMENT</p>
            <h2 id="alignment-title">班级进度对齐</h2>
          </div>
          <button id="alignment-refresh" type="button">刷新</button>
        </div>
        <p class="teacher-hint">
          教师 Agent 通过 MCP
          生成不可改写的建议快照。教师在这里核对证据，再逐人确认、改组或驳回；没有证据时保持“待补证”。
        </p>
        <div class="alignment-controls">
          <label
            >共同能力里程碑
            <select id="alignment-milestone" aria-label="共同能力里程碑"
            ></select>
          </label>
          <label
            >建议快照
            <select id="alignment-run" aria-label="建议快照"></select>
          </label>
        </div>
        <p
          id="alignment-status"
          class="teacher-hint"
          role="status"
          aria-live="polite"
        >
          连接后读取班级进度。
        </p>
        <ul id="alignment-recommendations" class="alignment-recommendations">
        </ul>
      </section>

      <section
        id="student-panel"
        class="teacher-card"
        aria-labelledby="student-title"
        hidden
      >
        <div class="teacher-card-heading">
          <div>
            <p class="teacher-eyebrow">PRIVATE PROFILE</p><h2
              id="student-title"
            >
              学生档案
            </h2>
          </div>
          <span id="student-version" class="teacher-count"></span>
        </div>
        <p id="student-meta" class="teacher-hint"></p>
        <div id="teacher-profile" class="teacher-profile">
          <label
            >姓名<input name="display_name" required maxlength="80" /></label
          >
          <label
            >公开别名（不得含姓名）<input
              name="public_alias"
              required
              maxlength="80"
            /></label
          >
          <label class="teacher-wide"
            >教学目标<textarea name="learning_goals" rows="3" maxlength="3000"
            ></textarea></label
          >
          <label class="teacher-wide"
            >教师备注<textarea name="teacher_notes" rows="4" maxlength="6000"
            ></textarea></label
          >
          <button class="btn-ac" type="button">保存档案修订</button>
        </div>
        <div class="teacher-reports">
          <h3>已批准报告</h3>
          <p class="teacher-hint">
            只展示后端已批准的测评结果；未批改或待复核答卷不会显示在这里。
          </p>
          <p
            id="teacher-report-status"
            class="teacher-hint"
            role="status"
            aria-live="polite"
          >
          </p>
          <ul id="teacher-reports"></ul>
          <div id="teacher-report-detail" class="teacher-report-detail" hidden>
          </div>
        </div>
        <div class="teacher-plans">
          <h3>四周个人计划</h3>
          <p class="teacher-hint">
            教师 Agent
            根据已确认的进度对齐建议提交草稿；教师逐份核对后填写依据并批准。
          </p>
          <p
            id="teacher-plan-status"
            class="teacher-hint"
            role="status"
            aria-live="polite"
          >
          </p>
          <ul id="teacher-plans"></ul>
        </div>
        <div class="teacher-archive">
          <h3>审计归档</h3>
          <p class="teacher-hint">
            显示归档引用和校验状态，不在页面中暴露原始答卷。
          </p>
          <ul id="teacher-artifacts"></ul>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { initTeacherDashboard } from "../lib/teacherDashboard";
  document.addEventListener("astro:page-load", initTeacherDashboard);
  initTeacherDashboard();
</script>

<style>
  .teacher-page {
    color: var(--ac-text-dark);
    max-width: 980px;
    margin: 0 auto 4rem;
  }
  .teacher-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .teacher-heading h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0.25rem 0 0.5rem;
  }
  .teacher-heading p:last-child {
    color: var(--ac-text);
    line-height: 1.6;
  }
  .teacher-eyebrow {
    color: var(--ac-primary-dark);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }
  .teacher-badge,
  .teacher-count {
    background: var(--ac-cream-dark);
    color: var(--ac-text-dark);
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .teacher-card {
    background: var(--ac-surface);
    border: 1px solid var(--ac-border);
    border-top: 4px solid var(--ac-primary);
    border-radius: var(--ac-radius-lg);
    box-shadow: var(--ac-shadow);
    padding: clamp(1.1rem, 3vw, 1.75rem);
    margin-bottom: 1.25rem;
  }
  .teacher-card h2 {
    font-size: 1.35rem;
    font-weight: 800;
    margin: 0.25rem 0 0.7rem;
  }
  .teacher-card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .teacher-hint {
    color: var(--ac-text);
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .teacher-connect,
  .teacher-profile {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
    align-items: end;
  }
  .teacher-connect label,
  .teacher-profile label {
    display: grid;
    gap: 0.45rem;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .teacher-connect input,
  .teacher-profile input,
  .teacher-profile textarea {
    width: 100%;
    border: 1px solid var(--ac-border);
    border-radius: var(--ac-radius-sm);
    background: var(--ac-cream);
    padding: 0.75rem;
    color: var(--ac-text-dark);
    font: inherit;
  }
  .teacher-connect input:focus-visible,
  .teacher-profile input:focus-visible,
  .teacher-profile textarea:focus-visible,
  .teacher-roster :global(button:focus-visible) {
    outline: 3px solid var(--ac-primary);
    outline-offset: 2px;
  }
  .teacher-connect button,
  .teacher-profile button {
    justify-self: start;
  }
  .teacher-status {
    margin-top: 1rem;
    min-height: 1.5rem;
    color: var(--ac-primary-dark);
    font-weight: 700;
  }
  .teacher-status[data-error="true"] {
    color: #a33d38;
  }
  #alignment-status[data-error="true"] {
    color: #a33d38;
  }
  .teacher-roster {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
  }
  .teacher-roster :global(button) {
    width: 100%;
    text-align: left;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--ac-border);
    border-radius: var(--ac-radius-md);
    background: var(--ac-cream);
    transition: var(--ac-transition);
  }
  .teacher-roster :global(button:hover),
  .teacher-roster :global(button[aria-current="true"]) {
    border-color: var(--ac-primary);
    background: var(--ac-surface-hover);
    box-shadow: var(--ac-shadow);
  }
  .teacher-roster :global(small) {
    color: var(--ac-text);
  }
  .alignment-controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 1rem 0;
  }
  .alignment-controls label {
    display: grid;
    gap: 0.45rem;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .alignment-controls select,
  .alignment-recommendations :global(input),
  .alignment-recommendations :global(select) {
    width: 100%;
    border: 1px solid var(--ac-border);
    border-radius: var(--ac-radius-sm);
    background: var(--ac-cream);
    padding: 0.65rem;
    color: var(--ac-text-dark);
    font: inherit;
  }
  #alignment-refresh,
  .alignment-recommendations :global(button) {
    border: 1px solid var(--ac-primary-dark);
    border-radius: var(--ac-radius-sm);
    background: var(--ac-cream);
    color: var(--ac-primary-dark);
    padding: 0.55rem 0.8rem;
    font-weight: 800;
  }
  .alignment-recommendations {
    display: grid;
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .alignment-recommendations :global(li) {
    border: 1px solid var(--ac-border);
    border-radius: var(--ac-radius-md);
    background: var(--ac-surface-hover);
    padding: 1rem;
  }
  .alignment-recommendations :global(h3) {
    font-size: 1rem;
    font-weight: 800;
  }
  .alignment-recommendations :global(p) {
    margin: 0.4rem 0;
    line-height: 1.5;
  }
  .alignment-recommendations :global(.alignment-decision) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 0.8rem;
  }
  .alignment-recommendations :global(.alignment-decision label) {
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .alignment-recommendations :global(.alignment-decision button) {
    justify-self: start;
  }
  .alignment-recommendations :global(.alignment-evidence) {
    font-size: 0.85rem;
    color: var(--ac-text);
    overflow-wrap: anywhere;
  }
  .alignment-controls select:focus-visible,
  #alignment-refresh:focus-visible,
  .alignment-recommendations :global(button:focus-visible),
  .alignment-recommendations :global(input:focus-visible),
  .alignment-recommendations :global(select:focus-visible) {
    outline: 3px solid var(--ac-primary);
    outline-offset: 2px;
  }
  .teacher-wide {
    grid-column: 1 / -1;
  }
  #pending-attempts :global(li) {
    border: 1px solid var(--ac-border);
    border-radius: var(--ac-radius-md);
    background: var(--ac-cream);
    padding: 0.8rem 1rem;
    overflow-wrap: anywhere;
  }
  #pending-refresh,
  .teacher-reports :global(button) {
    border: 1px solid var(--ac-primary-dark);
    border-radius: var(--ac-radius-sm);
    background: var(--ac-cream);
    color: var(--ac-primary-dark);
    padding: 0.5rem 0.8rem;
    font-weight: 800;
  }
  .teacher-reports {
    margin-top: 2rem;
    border-top: 1px solid var(--ac-border);
    padding-top: 1.4rem;
  }
  .teacher-reports h3 {
    font-size: 1.1rem;
    font-weight: 800;
  }
  .teacher-reports :global(li) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--ac-border);
  }
  .teacher-reports :global(li span) {
    overflow-wrap: anywhere;
  }
  .teacher-report-detail {
    margin-top: 1rem;
    border: 1px solid var(--ac-border);
    border-radius: var(--ac-radius-md);
    background: var(--ac-surface-hover);
    padding: 1rem;
    overflow-wrap: anywhere;
  }
  .teacher-report-detail :global(p) {
    margin: 0.45rem 0;
    line-height: 1.55;
  }
  #pending-status[data-error="true"],
  #teacher-report-status[data-error="true"] {
    color: #a33d38;
  }
  #pending-refresh:focus-visible,
  .teacher-reports :global(button:focus-visible) {
    outline: 3px solid var(--ac-primary);
    outline-offset: 2px;
  }
  .teacher-plans {
    margin-top: 2rem;
    border-top: 1px solid var(--ac-border);
    padding-top: 1.4rem;
  }
  .teacher-plans h3 {
    font-size: 1.1rem;
    font-weight: 800;
  }
  #teacher-plans :global(li) {
    margin-top: 0.8rem;
    padding: 1rem;
    border: 1px solid var(--ac-border);
    border-radius: var(--ac-radius-md);
    background: var(--ac-surface-hover);
    overflow-wrap: anywhere;
  }
  #teacher-plans :global(li li) {
    border: 0;
    margin: 0;
    padding: 0.15rem 0;
    background: transparent;
  }
  #teacher-plans :global(ol) {
    margin: 0.5rem 0 0.7rem 1.5rem;
  }
  #teacher-plans :global(p) {
    margin: 0.4rem 0;
  }
  #teacher-plans :global(label) {
    display: block;
    margin: 0.8rem 0;
    font-weight: 700;
  }
  #teacher-plans :global(textarea) {
    display: block;
    width: 100%;
    margin-top: 0.35rem;
    padding: 0.6rem;
    border: 1px solid var(--ac-border);
    border-radius: var(--ac-radius-sm);
    background: var(--ac-cream);
    color: var(--ac-text-dark);
  }
  #teacher-plans :global(button) {
    border: 1px solid var(--ac-primary-dark);
    border-radius: var(--ac-radius-sm);
    background: var(--ac-cream);
    color: var(--ac-primary-dark);
    padding: 0.5rem 0.8rem;
    font-weight: 800;
  }
  #teacher-plans :global(button:focus-visible),
  #teacher-plans :global(textarea:focus-visible) {
    outline: 3px solid var(--ac-primary);
    outline-offset: 2px;
  }
  #teacher-plan-status[data-error="true"] {
    color: #a33d38;
  }
  .teacher-archive {
    margin-top: 2rem;
    border-top: 1px solid var(--ac-border);
    padding-top: 1.4rem;
  }
  .teacher-archive h3 {
    font-size: 1.1rem;
    font-weight: 800;
  }
  .teacher-archive :global(li) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--ac-border);
    overflow-wrap: anywhere;
  }
  .teacher-archive :global(button) {
    color: var(--ac-primary-dark);
    font-weight: 800;
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .teacher-heading {
      display: block;
    }
    .teacher-badge {
      display: inline-block;
      margin-top: 1rem;
    }
    .teacher-connect,
    .teacher-profile,
    .alignment-controls,
    .alignment-recommendations :global(.alignment-decision) {
      grid-template-columns: 1fr;
    }
  }
</style>

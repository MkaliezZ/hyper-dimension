      ],
      "prompt": "一位新同伴来到你的小组。请先介绍自己，再问对方叫什么，并用一句话回应。可以看人物图片，但不能照读完整台词。",
      "interactive_role": "教师或同伴扮演新成员，回答姓名并提出一个简单追问",
      "support_allowed": "人物图片；不提供完整句子",
      "analytic_rubric": {
        "intent": "对方是否知道学生是谁",
        "initiative": "是否主动询问新成员",
        "response": "是否根据对方回答作出相关回应",
        "intelligibility": "表达是否可被理解"
      },
      "explanation": "观察是否完成介绍、提问和回应；可接受不同正确表达，保留提示和原话证据。",
      "expected_minutes": 3,
      "review_status": "pending_teacher_review",
      "public_format_source_url": "https://www.cambridgeenglish.org/exams-and-tests/qualifications/key/format/",
      "knowledge_tags": [

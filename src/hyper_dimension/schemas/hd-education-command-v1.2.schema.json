{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hyperdimension:education:command:1.2",
  "title": "Hyper Dimension Education Command 1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "operation",
    "request_id",
    "island_id",
    "idempotency_key",
    "purpose",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.2"
    },
    "operation": {
      "enum": [
        "hd.education.plan.read.v1",
        "hd.education.assignment.read.v1",
        "hd.education.evidence.submit.v1",
        "hd.education.feedback.request.v1",
        "hd.education.teacher_help.request.v1",
        "hd.education.student.profile.read.v1",
        "hd.education.student.profile.update.v1",
        "hd.education.student.archive.list.v1",
        "hd.education.student.archive.verify.v1",
        "hd.education.showcase.draft.create.v1",
        "hd.education.showcase.public.read.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "island_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "student_ref": {
      "type": "string",
      "pattern": "^stu_[0-9a-f]{32}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "purpose": {
      "enum": [
        "learning",
        "student_record",
        "public_showcase"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "operation": {
          "const": "hd.education.plan.read.v1"
        },
        "purpose": {
          "const": "learning"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      },
      "required": [
        "student_ref"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "hd.education.assignment.read.v1"
        },
        "purpose": {
          "const": "learning"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assignment_ref"
          ],
          "properties": {
            "assignment_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            }
          }
        }
      },
      "required": [
        "student_ref"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "hd.education.evidence.submit.v1"
        },
        "purpose": {
          "const": "learning"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assignment_ref",
            "attempt_ref",
            "response_ref"
          ],
          "properties": {
            "assignment_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "attempt_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "response_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            }
          }
        }
      },
      "required": [
        "student_ref"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "hd.education.feedback.request.v1"
        },
        "purpose": {
          "const": "learning"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "submission_ref"
          ],
          "properties": {
            "submission_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            }
          }
        }
      },
      "required": [
        "student_ref"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "hd.education.teacher_help.request.v1"
        },
        "purpose": {
          "const": "learning"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assignment_ref",
            "question"
          ],
          "properties": {
            "assignment_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            }
          }
        }
      },
      "required": [
        "student_ref"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "hd.education.student.profile.read.v1"
        },
        "purpose": {
          "const": "student_record"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      },
      "required": [
        "student_ref"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "hd.education.student.profile.update.v1"
        },
        "purpose": {
          "const": "student_record"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_version",
            "display_name",
            "public_alias",
            "teacher_notes",
            "learning_goals"
          ],
          "properties": {
            "expected_version": {
              "type": "integer",
              "minimum": 1
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            },
            "public_alias": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            },
            "teacher_notes": {
              "type": "string",
              "maxLength": 6000
            },
            "learning_goals": {
              "type": "string",
              "maxLength": 3000
            }
          }
        }
      },
      "required": [
        "student_ref"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "hd.education.student.archive.list.v1"
        },
        "purpose": {
          "const": "student_record"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      },
      "required": [
        "student_ref"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "hd.education.student.archive.verify.v1"
        },
        "purpose": {
          "const": "student_record"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_ref"
          ],
          "properties": {
            "artifact_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            }
          }
        }
      },
      "required": [
        "student_ref"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "hd.education.showcase.draft.create.v1"
        },
        "purpose": {
          "const": "public_showcase"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slot",
            "kind",
            "title",
            "summary",
            "source_artifact_ref",
            "publication_consent_ref"
          ],
          "properties": {
            "slot": {
              "enum": [
                "learning",
                "portfolio",
                "honors"
              ]
            },
            "kind": {
              "enum": [
                "improvement",
                "honor"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "source_artifact_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "publication_consent_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "baseline_artifact_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "before_score",
                "after_score",
                "unit"
              ],
              "properties": {
                "before_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "after_score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20,
                  "pattern": "\\S"
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "improvement"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "required": [
                  "metrics",
                  "baseline_artifact_ref"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "honor"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "metrics"
                      ]
                    },
                    {
                      "required": [
                        "baseline_artifact_ref"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "student_ref"
      ]
    },
    {
      "properties": {
        "operation": {
          "const": "hd.education.showcase.public.read.v1"
        },
        "purpose": {
          "const": "public_showcase"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "slot": {
              "enum": [
                "learning",
                "portfolio",
                "honors"
              ]
            }
          }
        }
      },
      "required": [],
      "not": {
        "required": [
          "student_ref"
        ]
      }
    }
  ]
}

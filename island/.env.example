# Private target configuration: copy only when .env.local is absent.
DEEPSEEK_API_KEY=
HD_HERMES_INSTALL=.runtime/hermes-agent
# Native Python location is discovered on the target OS.
# Optional: HD_SAVE_DIR=data/saves

# Optional shared visual day/night + season clock. Blank URL keeps local shared time.
HD_WORLD_CLOCK_URL=
# Private Bearer credential; never published or sent to NPC models.
HD_WORLD_CLOCK_TOKEN=
# Optional: HD_ENVIRONMENT_DIR=data/environment
